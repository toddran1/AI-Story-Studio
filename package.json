{
  "name": "ai-story-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "story:process": "node --import tsx apps/cli/index.ts process",
    "story:batch": "node --import tsx apps/cli/batch.ts",
    "story:inspect": "node --import tsx apps/cli/source.ts inspect",
    "story:import": "node --import tsx apps/cli/source.ts import",
    "story:refresh": "node --import tsx apps/cli/refresh.ts",
    "story:repair": "node --import tsx apps/cli/repair.ts",
    "story:preview": "node --import tsx apps/cli/preview.ts",
    "story:profile": "node --import tsx apps/cli/profile.ts",
    "smoke": "node --import tsx apps/cli/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.0.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.2",
    "openai": "^6.0.0",
    "pino": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
