# Copy to .env. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.8-flash
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2-pro
FISH_AUDIO_REFERENCE_ID=

# Optional Fish Audio tuning
FISH_AUDIO_SPEED=1
FISH_AUDIO_SAMPLE_RATE=44100
FISH_AUDIO_MP3_BITRATE=128
FISH_AUDIO_NORMALIZE=true
FISH_AUDIO_MAX_CHARS=4000
LOG_LEVEL=info
