# Copy to .env. Never commit real credentials.
# Persistent app data. Relative paths are resolved from the project directory.
STUDIO_DATA_ROOT=./.data
# Docker Compose cannot derive a nested value from STUDIO_DATA_ROOT, so keep this aligned.
POSTGRES_DATA_DIR=./.data/postgres
DATABASE_URL=postgresql://ai_story_studio:ai_story_studio@127.0.0.1:5433/ai_story_studio
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.8-flash
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2-pro
FISH_AUDIO_REFERENCE_ID=

# Optional Fish Audio tuning
FISH_AUDIO_SPEED=1
FISH_AUDIO_SAMPLE_RATE=44100
FISH_AUDIO_MP3_BITRATE=128
FISH_AUDIO_NORMALIZE=true
FISH_AUDIO_MAX_CHARS=4000
LOG_LEVEL=info
PROVIDER_TIMEOUT_MS=120000
MEDIA_PROCESS_TIMEOUT_MS=1800000
ALIGNMENT_ENGINE=whisper-cpp
ALIGNMENT_EXECUTABLE=whisper-cli
# Store the model beneath STUDIO_DATA_ROOT, for example models/ggml-base.en.bin.
ALIGNMENT_MODEL=models/ggml-base.en.bin
ALIGNMENT_DEVICE=auto
ALIGNMENT_MIN_MATCH_PERCENT=85
ALIGNMENT_MIN_CONFIDENCE=0.45
ALIGNMENT_MAX_GAP_SECONDS=15
ALIGNMENT_TIMEOUT_MS=1800000
WEB_REQUEST_TIMEOUT_MS=30000
WEB_REQUEST_DELAY_MS=500
WEB_MAX_RESPONSE_BYTES=5000000
WEB_MAX_RETRIES=2
# Relative cache paths are resolved inside STUDIO_DATA_ROOT.
WEB_CACHE_DIR=cache/web
WEB_PORT=3000
QUEUE_POLL_MS=1000
QUEUE_LEASE_MS=300000
QUEUE_MAX_ATTEMPTS=5
QUEUE_EVENT_RETENTION_DAYS=90
PROVIDER_MIN_SPACING_MS=0
